{
  "$comment": "Brand data for the Bankai developer site. Source of truth: 'Bankai \u00b7 Logo Concepts' \u2192 'Build spec (source of truth)' (Craft, LOCKED by Sergio, 2026-11-04) and the brand asset package README (src/brand/logo/README.md). The cyan accent is Sergio's working pick and provisional: every colour is a token so a swap is one edit here. The terminal* tokens are the dark panel's own colours in both schemes (the panel never switches); inputBorder is the \u2265 3:1 control boundary (WCAG 1.4.11).",
  "wordmark": {
    "text": "bankai",
    "accentPart": "ai",
    "rule": "lowercase bankai, ai in the accent colour at the same weight and case; never an uppercase AI, never BankAI"
  },
  "marks": {
    "bankai": {
      "name": "Deterministic Path",
      "file": "marks/bankai-mark-{scheme}.svg"
    },
    "nen": {
      "name": "Loop & Gate",
      "file": "marks/nen-mark-{scheme}.svg"
    },
    "hatsu": {
      "name": "Gate Prompt",
      "file": "marks/hatsu-mark-{scheme}.svg"
    },
    "handbooks": {
      "name": "Handbooks mark",
      "file": "marks/handbooks-mark-{scheme}.svg"
    },
    "library": {
      "name": "Library mark",
      "file": "marks/library-mark-{scheme}.svg"
    },
    "cloud": {
      "name": "Cloud placeholder mark",
      "file": "marks/cloud-placeholder-mark-{scheme}.svg"
    }
  },
  "lockups": {
    "horizontal": "lockups/bankai-lockup-horizontal-{scheme}.svg",
    "stacked": "lockups/bankai-lockup-stacked-{scheme}.svg",
    "nen": "lockups/bankai-nen-lockup-{scheme}.svg",
    "hatsu": "lockups/bankai-hatsu-lockup-{scheme}.svg"
  },
  "schemeNote": "In the asset package, '-dark' means artwork FOR dark backgrounds and '-light' artwork FOR light backgrounds.",
  "fonts": {
    "display": {
      "family": "Space Grotesk",
      "license": "SIL OFL 1.1",
      "use": "wordmark, headings, UI"
    },
    "mono": {
      "family": "JetBrains Mono",
      "license": "SIL OFL 1.1",
      "use": "sub-brands, CLI, code, labels"
    }
  },
  "mode": {
    "default": "dark",
    "alternatives": [
      "light"
    ]
  },
  "colors": {
    "dark": {
      "bg": "#0A0C10",
      "surface": "#121722",
      "terminal": "#0D1117",
      "text": "#E6E9EF",
      "muted": "#9AA4B2",
      "accent": "#22D3EE",
      "aiAccent": "#22D3EE",
      "onAccent": "#0A0C10",
      "disclaimer": "#7C8796",
      "terminalText": "#E6E9EF",
      "terminalMuted": "#9AA4B2",
      "terminalAccent": "#22D3EE",
      "inputBorder": "#9AA4B2"
    },
    "light": {
      "bg": "#F6F7F9",
      "surface": "#FFFFFF",
      "terminal": "#0D1117",
      "text": "#0A0C10",
      "muted": "#4B5563",
      "accent": "#0E7490",
      "aiAccent": "#0E7490",
      "onAccent": "#FFFFFF",
      "disclaimer": "#5F6876",
      "terminalText": "#E6E9EF",
      "terminalMuted": "#9AA4B2",
      "terminalAccent": "#22D3EE",
      "inputBorder": "#4B5563"
    }
  },
  "contrast": {
    "text": {
      "dark": "16.1:1",
      "light": "18.3:1"
    },
    "muted": {
      "dark": "7.8:1",
      "light": "7.1:1"
    },
    "accent": {
      "dark": "10.8:1",
      "light": "5.0:1"
    },
    "disclaimer": {
      "dark": "5.4:1",
      "light": "5.3:1"
    }
  },
  "legal": {
    "full": "Bankai is an independent open-source project. It is not affiliated with, endorsed by, or sponsored by the creators, publishers, or rights holders of any anime or manga whose terms inspired its names. All trademarks belong to their respective owners.",
    "short": "Independent open-source project. Not affiliated with or endorsed by any anime or manga rights holder.",
    "footerSizePx": {
      "min": 10,
      "web": [
        11,
        12
      ]
    },
    "spanish": "pending sign-off; use the English line"
  },
  "geometry": {
    "grid": 100,
    "nodes": [
      18,
      50,
      82
    ],
    "stroke": 12,
    "faviconStroke": 16,
    "radius": 3
  }
}
