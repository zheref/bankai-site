{
  "name": "bankai-site",
  "private": true,
  "version": "0.1.0",
  "description": "The public developer site for Bankai (working codename: site).",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sources:fetch": "node scripts/sources/fetch.mjs",
    "sources:collect": "node scripts/sources/collect.mjs",
    "fonts:fallbacks": "node scripts/fonts/fallbacks.mjs",
    "prebuild": "node scripts/sources/collect.mjs",
    "predevelop": "node scripts/sources/collect.mjs",
    "develop": "gatsby develop",
    "build": "gatsby clean && gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:build": "vitest run --config vitest.build.config.ts",
    "test:e2e": "playwright test",
    "test:ui": "playwright test",
    "build:incremental": "gatsby build",
    "pretest": "node scripts/sources/collect.mjs",
    "pretest:coverage": "node scripts/sources/collect.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@mdx-js/react": "2.3.0",
    "flexsearch": "^0.8.212",
    "gatsby": "5.16.1",
    "gatsby-plugin-manifest": "5.16.0",
    "gatsby-plugin-mdx": "5.16.0",
    "gatsby-plugin-postcss": "6.16.0",
    "gatsby-plugin-sitemap": "6.16.0",
    "gatsby-remark-autolink-headers": "6",
    "gatsby-source-filesystem": "5.16.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.4.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "lighthouse": "^12.8.0",
    "postcss": "^8.5.6",
    "remark-gfm": "^3.0.1",
    "shiki": "^3.13.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "gatsby",
      "gatsby-cli",
      "gatsby-telemetry",
      "gatsby-sharp",
      "lmdb",
      "msgpackr-extract",
      "esbuild",
      "@parcel/watcher",
      "@swc/core",
      "unrs-resolver"
    ]
  }
}
